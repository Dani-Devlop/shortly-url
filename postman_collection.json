        "url": {
          "raw": "{{baseUrl}}/api/stats/sparklines?days=7",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stats",
            "sparklines"
          ],
          "query": [
            {
              "key": "days",
              "value": "7",
              "description": "Window length: 1–30 days"
            },
            {
              "key": "limit",
              "value": "50",
              "description": "Max links returned"
            }
          ]
        },
        "description": "Per-link zero-filled daily click series (oldest → newest), newest links first."
      }
    },
