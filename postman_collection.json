  "item": [
    {
      "name": "Shorten URL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Response has code', () => pm.expect(body).to.have.property('code'));",
              "pm.collectionVariables.set('code', body.code);",
              "console.log('code saved to collection variable:', body.code);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com/some/very/long/path\",\n  \"custom_code\": null,\n  \"utm_template\": \"utm_source=newsletter&utm_campaign=launch\",\n  \"tags\": [\"docs\", \"launch\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/shorten",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shorten"
          ]
        },
        "description": "Create a short link. Duplicate URLs from the same owner return the existing link. Optional `custom_code` (4–16 chars, letters/digits/-/_), optional `utm_template` (default query params appended on every redirect; explicit short-URL params and destination params take precedence), and optional `tags` (max 6, normalised: trimmed/lowercased, spaces → '-', 2–24 chars). With Redis enabled the response carries X-RateLimit-* headers; exceeding the budget answers 429 with Retry-After."
      }
    },
    {
