              "const body = pm.response.json();",
              "pm.test('items is an array', () => pm.expect(body.items).to.be.an('array'));",
              "pm.test('points are zero-filled per window', () => pm.expect(body.items[0].points.length).to.eql(body.window_days));"
            ]
          }
        }
