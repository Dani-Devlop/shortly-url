            "referrers?days=7&limit=10"
          ],
          "query": []
        },
        "description": "Top traffic sources for one link within a rolling window. 'total' counts every click in the window (even beyond 'limit'); 'direct' = no referer header. Each item carries a 'devices' cross-tab (clicks per device class for that source) so clients can render stacked bars without extra calls."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('envelope has code/window_days/total/items', () => {",
              "    pm.expect(body).to.have.property('code');",
              "    pm.expect(body).to.have.property('window_days');",
              "    pm.expect(body).to.have.property('total');",
              "    pm.expect(body.items).to.be.an('array');",
              "});",
              "pm.test('each item has a devices cross-tab summing to clicks', () => {",
              "    body.items.forEach((item) => {",
              "        pm.expect(item).to.have.property('devices');",
              "        const sum = Object.values(item.devices || {}).reduce((a, b) => a + b, 0);",
              "        pm.expect(sum).to.eql(item.clicks);",
              "    });",
              "});"
            ]
          }
        }
      ]
