    {
      "name": "List My Links",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"paginated envelope\", () => {",
              "  pm.expect(body).to.have.property('items');",
              "  pm.expect(body).to.have.property('total');",
              "  pm.expect(body).to.have.property('limit');",
              "  pm.expect(body).to.have.property('offset');",
              "});",
              "if (body.items && body.items.length) {",
              "  pm.collectionVariables.set('code', body.items[0].code);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/links?limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "links"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20",
              "description": "1–100 (default 20)"
            },
            {
              "key": "offset",
              "value": "0",
              "description": "0-based"
            }
          ]
        },
        "description": "Paginated list of the authenticated user's links.\n\nReturns `{items, total, limit, offset}` — `total` counts all the user's links."
      }
    },
