          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('envelope has window_days/total/items', () => {",
              "    pm.expect(body).to.have.property('window_days');",
              "    pm.expect(body).to.have.property('total');",
              "    pm.expect(body.items).to.be.an('array');",
              "});",
              "pm.test('device classes are known', () => {",
              "    const known = ['desktop','mobile','tablet','bot','other'];",
              "    body.items.forEach((i) => pm.expect(known).to.include(i.device));",
              "});"
            ]
          }
