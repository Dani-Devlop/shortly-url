{
  "info": {
    "_postman_id": "b7e6a1c2-3f4d-4e5a-9b8c-1d2e3f4a5b6c",
    "name": "shortly-url API",
    "description": "Complete collection for the shortly-url link shortener.\n\nSet collection variables `baseUrl` and `apiKey` (Pre-request Scripts tab → Variables) and every request works against local (`http://localhost:8000`) or the live Render demo.\n\nThe **Shorten** request automatically stores the returned code in the `code` collection variable, so Redirect/Stats/Delete requests work right after it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiKey",
      "value": "change-me-master-key"
    },
    {
      "key": "code",
      "value": "aB3xK9m"
    }
  ],
  "item": [
    {
      "name": "Shorten URL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Response has code', () => pm.expect(body).to.have.property('code'));",
              "pm.collectionVariables.set('code', body.code);",
              "console.log('code saved to collection variable:', body.code);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com/some/very/long/path\",\n  \"custom_code\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/shorten",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shorten"
          ]
        },
        "description": "Create a short link. Duplicate URLs from the same owner return the existing link. Optional `custom_code` must be 4–16 chars (letters/digits/-/_)."
      }
    },
    {
      "name": "Bulk Shorten",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('results is an array', () => pm.expect(body.results).to.be.an('array'));",
              "pm.test('counts add up', () => pm.expect(body.results.length).to.eql(body.created + body.duplicate + body.errors));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"urls\": [\n    \"https://example.com/bulk/one\",\n    \"https://example.com/bulk/two\",\n    \"https://example.com/bulk/three\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/shorten/bulk",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shorten",
            "bulk"
          ]
        },
        "description": "Shorten 1–25 URLs in one call. Each item reports created / duplicate / error independently. Consumes one rate-limit unit per URL."
      }
    },
    {
      "name": "Redirect (no follow)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 302 Found', () => pm.response.to.have.status(302));",
              "pm.test('Location header present', () => pm.response.headers.get('Location') !== undefined);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{code}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{code}}"
          ]
        },
        "description": "Follow the short link. Each call records a click asynchronously (background task)."
      }
    },
