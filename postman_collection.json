    "name": "shortly-url API",
    "description": "Complete collection for the shortly-url link shortener.\n\nSet collection variables `baseUrl` and `apiKey` (Pre-request Scripts tab → Variables) and every request works against local (`http://localhost:8000`) or the live Render demo.\n\nThe **Shorten** request automatically stores the returned code in the `code` collection variable, so Redirect/Stats/Delete requests work right after it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiKey",
      "value": "change-me-master-key"
    },
    {
      "key": "code",
      "value": "aB3xK9m"
    }
  ],
  "item": [
    {
      "name": "Shorten URL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Response has code', () => pm.expect(body).to.have.property('code'));",
              "pm.collectionVariables.set('code', body.code);",
              "console.log('code saved to collection variable:', body.code);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com/some/very/long/path\",\n  \"custom_code\": null,\n  \"utm_template\": \"utm_source=newsletter&utm_campaign=launch\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/shorten",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shorten"
          ]
        },
        "description": "Create a short link. Duplicate URLs from the same owner return the existing link. Optional `custom_code` (4–16 chars, letters/digits/-/_) and optional `utm_template` (default query params appended on every redirect; explicit short-URL params and destination params take precedence). With Redis enabled the response carries X-RateLimit-* headers; exceeding the budget answers 429 with Retry-After."
      }
    },
    {
      "name": "Bulk Shorten",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('results is an array', () => pm.expect(body.results).to.be.an('array'));",
              "pm.test('counts add up', () => pm.expect(body.results.length).to.eql(body.created + body.duplicate + body.errors));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"urls\": [\n    \"https://example.com/bulk/one\",\n    \"https://example.com/bulk/two\",\n    \"https://example.com/bulk/three\"\n  ]\n}"
