    },
    {
      "name": "Export — Clicks CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content is CSV', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));",
              "pm.test('Has header row', () => pm.expect(pm.response.text().split('\\n')[0]).to.eql('clicked_at,ip_hash,user_agent'));"
            ]
