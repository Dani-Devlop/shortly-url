# --- Database (async driver required) ---
DATABASE_URL=postgresql+asyncpg://shortly:shortly@localhost:5432/shortly

# --- Redis ---
# Leave empty ("") to run without cache & rate-limiting; the app degrades gracefully.
REDIS_URL=redis://localhost:6379/0

# --- Application ---
BASE_URL=http://localhost:8000
ENVIRONMENT=development

# --- Security ---
# API key of the bootstrap "master" user (created at startup). CHANGE IN PRODUCTION!
MASTER_API_KEY=change-me-master-key
# Salt used to hash visitor IPs before storing them. CHANGE IN PRODUCTION!
IP_HASH_SALT=change-me-ip-salt

# --- Behaviour ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=3600
CODE_LENGTH=7

# Dev/demo convenience: create tables from ORM metadata at startup (use Alembic in production).
AUTO_CREATE_TABLES=false
